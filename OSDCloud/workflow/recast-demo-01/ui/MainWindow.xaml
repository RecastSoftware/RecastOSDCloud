<?xml version="1.0" encoding="UTF-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Recast Software - OSDCloud" Width="960" Height="720" MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#161F5B" BorderBrush="#000000" BorderThickness="1"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#F5F5F5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Recast Software - OSDCloud">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" GlassFrameThickness="0,0,0,1"
                            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#31D1FF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1C2868"/>
        <SolidColorBrush x:Key="ControlBrush" Color="#243475"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#53639C"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#2D4088"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#1F50A5"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CDD9F3"/>
        <SolidColorBrush x:Key="SidebarBrush" Color="#111949"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#FFCC80"/>
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageDecrease" Command="ScrollBar.PageUpCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageIncrease" Command="ScrollBar.PageDownCommand"
                                                  Style="{StaticResource ScrollBarPageButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="12"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                                <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="MinHeight" Value="70"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TaskCardStyle" TargetType="Border" BasedOn="{StaticResource SettingCardStyle}">
            <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
        </Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DescriptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,12,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,16,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CopyValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="SidebarNavigationIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="LineHeight" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ButtonIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="LineHeight" Value="NaN"/>
            <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MaxWidth" Value="560"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="{StaticResource SidebarBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RowBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarNavigationItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBorder" Background="Transparent" BorderBrush="Transparent"
                                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="NavigationContent" Margin="4,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                            <Border x:Name="SelectedIndicator" Width="3" Margin="0,6"
                                    HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                    CornerRadius="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Compact">
                                <Setter TargetName="NavigationContent" Property="Margin" Value="0"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource ControlBrush}"/>
                                <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ButtonContent" Margin="4,0,0,0" RecognizesAccessKey="True"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Compact">
                                <Setter TargetName="ButtonContent" Property="Margin" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource ControlBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#F5F5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#161F5B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="RunButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- WPF shows FocusVisualStyle only for keyboard focus, so mouse clicks leave no outline. -->
        <Style x:Key="TitleBarFocusVisualStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="4,6" RadiusX="4" RadiusY="4" Stroke="#F5F5F5"
                                   StrokeThickness="1" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource TitleBarFocusVisualStyle}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CaptionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionBorder" Property="Background" Value="{StaticResource ControlBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#C42B1C"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="CaptionBorder" Property="Background" Value="#A82418"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Tag" Value="Close"/>
        </Style>
        <Style x:Key="TitleBarMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
        <Style x:Key="TitleBarIconStyle" TargetType="TextBlock" BasedOn="{StaticResource IconStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="LineHeight" Value="NaN"/>
            <Setter Property="LineStackingStrategy" Value="MaxHeight"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="MaxDropDownHeight" Value="360"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" CornerRadius="4" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.2"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SelectionPresenter" Margin="10,4,32,4" IsHitTestVisible="False"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Border x:Name="FocusBorder" CornerRadius="4" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="4">
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{StaticResource SidebarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PaneToggleButton" Grid.Column="0" Style="{StaticResource TitleBarButtonStyle}" Width="56"
                    ToolTip="Collapse navigation" AutomationProperties.Name="Collapse navigation">
                <TextBlock Text="&#xE700;" Style="{StaticResource TitleBarIconStyle}" FontSize="16"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock x:Name="TitleText" Text="Recast Software - OSDCloud" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="VersionText" Margin="12,0,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <TextBlock Text="&#xE921;" Style="{StaticResource TitleBarIconStyle}"/>
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                    <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" Style="{StaticResource TitleBarIconStyle}"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButtonStyle}" ToolTip="Close" AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource TitleBarIconStyle}"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="200" Background="{StaticResource SidebarBrush}" Padding="8">
                <DockPanel LastChildFill="True">
                    <Button x:Name="PrivacyButton" DockPanel.Dock="Bottom" Style="{StaticResource SidebarButtonStyle}"
                            ToolTip="Privacy" AutomationProperties.Name="Privacy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                            <TextBlock x:Name="PrivacyLabel" Text="Privacy" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource SidebarNavigationItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Navigation">
                        <ListBoxItem x:Name="NavDeploy" Tag="Deploy" AutomationProperties.Name="Deploy" ToolTip="Deploy">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                                <TextBlock x:Name="NavDeployLabel" Text="Deploy" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavDevice" Tag="Device" AutomationProperties.Name="Device" ToolTip="Device">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                                <TextBlock x:Name="NavDeviceLabel" Text="Device" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavIdentity" Tag="Identity" AutomationProperties.Name="Identity" ToolTip="Identity">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE779;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                                <TextBlock x:Name="NavIdentityLabel" Text="Identity" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavLogs" Tag="Logs" AutomationProperties.Name="Logs" ToolTip="Logs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                                <TextBlock x:Name="NavLogsLabel" Text="Logs" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavWmi" Tag="Wmi" AutomationProperties.Name="WMI" ToolTip="WMI">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                                <TextBlock x:Name="NavWmiLabel" Text="WMI" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem x:Name="NavTools" Tag="Tools" AutomationProperties.Name="Tools" ToolTip="Tools">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE756;" Style="{StaticResource SidebarNavigationIconStyle}" Width="24"/>
                                <TextBlock x:Name="NavToolsLabel" Text="Tools" Margin="12,0,0,0" Style="{StaticResource SidebarLabelStyle}"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="DeployPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="Deploy" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose the task sequence, operating system, and driver pack for this device." Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8FD;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Task Sequence" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Workflow steps that run during deployment" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="TaskSequenceCombo" Grid.Column="2" AutomationProperties.Name="Task Sequence"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE770;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Operating System" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Windows release to install" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="OperatingSystemCombo" Grid.Column="2" AutomationProperties.Name="Operating System"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE774;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Language" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="SelectedOSLanguageText" Text="-" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="OSLanguageCodeCombo" Grid.Column="2" AutomationProperties.Name="Language"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8EC;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Edition" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="Windows edition to apply from the image" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="OSEditionCombo" Grid.Column="2" AutomationProperties.Name="Edition"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*" MinWidth="180" MaxWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8D7;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Activation" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="OSActivationHintText" Text="Retail or Volume license channel" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="OSActivationCombo" Grid.Column="2" AutomationProperties.Name="Activation"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7B8;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Windows Image" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="SelectedFileNameText" Text="-" Style="{StaticResource DescriptionTextStyle}"/>
                                    <TextBlock x:Name="SelectedIdText" Text="-" Style="{StaticResource StatusTextStyle}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="&#xE964;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Driver Pack" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="DriverPackUrlText" Text="-" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <ComboBox x:Name="DriverPackCombo" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" AutomationProperties.Name="Driver Pack"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="DevicePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="Device" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Hardware details used to match driver packs and firmware." Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Manufacturer" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="deviceOSDManufacturerText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Model" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" x:Name="deviceOSDModelText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Product" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="deviceOSDProductText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="System SKU" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="deviceComputerSystemSKUText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="BIOS Version" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="deviceBiosVersionText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="BIOS Date" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" x:Name="deviceBiosReleaseDateText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="TPM 2.0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="deviceIsTpmSpecText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Autopilot Spec" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" x:Name="deviceIsAutopilotSpecText" Text="-" Style="{StaticResource ValueTextStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="IdentityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="Identity" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Click a value or use the copy button to copy it to the clipboard." Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Serial Number" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="deviceSerialNumberText" Text="-" Style="{StaticResource CopyValueTextStyle}" ToolTip="Click to copy Serial Number"/>
                                <Button Grid.Row="0" Grid.Column="2" x:Name="CopySerialNumberButton" Style="{StaticResource IconButtonStyle}" Margin="0,2" ToolTip="Copy Serial Number" AutomationProperties.Name="Copy Serial Number">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource ButtonIconStyle}"/>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="UUID" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="deviceUUIDText" Text="-" Style="{StaticResource CopyValueTextStyle}" ToolTip="Click to copy UUID"/>
                                <Button Grid.Row="1" Grid.Column="2" x:Name="CopyUUIDButton" Style="{StaticResource IconButtonStyle}" Margin="0,2" ToolTip="Copy UUID" AutomationProperties.Name="Copy UUID">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource ButtonIconStyle}"/>
                                </Button>
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="deviceHardwareHashLabelText" Text="Hardware Hash" Style="{StaticResource LabelTextStyle}" Visibility="Collapsed"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="deviceHardwareHashText" Text="Copy to Clipboard" Style="{StaticResource CopyValueTextStyle}" ToolTip="Click to copy Hardware Hash" Visibility="Collapsed"/>
                                <Button Grid.Row="2" Grid.Column="2" x:Name="CopyHardwareHashButton" Style="{StaticResource IconButtonStyle}" Margin="0,2" ToolTip="Copy Hardware Hash" AutomationProperties.Name="Copy Hardware Hash" Visibility="Collapsed">
                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource ButtonIconStyle}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="24,20,24,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="LogsPageTitle" Text="Logs" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LogsPageDescription" Style="{StaticResource DescriptionTextStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button x:Name="RefreshLogsButton" ToolTip="Refresh" AutomationProperties.Name="Refresh">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenLogButton" IsEnabled="False" ToolTip="Open in Notepad" AutomationProperties.Name="Open in Notepad">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Open" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="LogsList" Grid.Row="1" BorderThickness="1" AutomationProperties.Name="Log files"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
                <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="Tools" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="Open a command shell in WinPE for troubleshooting." Style="{StaticResource DescriptionTextStyle}" Margin="0,0,0,16"/>
                        <Border Style="{StaticResource TaskCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE756;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Command Prompt" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="cmd.exe" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <Button x:Name="RunCmdPrompt" Grid.Column="2" Content="Open" MinWidth="96" VerticalAlignment="Center" AutomationProperties.Name="Open Command Prompt"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource TaskCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE756;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Windows PowerShell" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock Text="powershell.exe" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <Button x:Name="RunPowerShell" Grid.Column="2" Content="Open" MinWidth="96" VerticalAlignment="Center" AutomationProperties.Name="Open Windows PowerShell"/>
                            </Grid>
                        </Border>
                        <Border x:Name="RunPwshCard" Style="{StaticResource TaskCardStyle}" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE756;" Style="{StaticResource IconStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="PowerShell 7" Style="{StaticResource CardTitleStyle}"/>
                                    <TextBlock x:Name="PwshPathText" Text="pwsh.exe" Style="{StaticResource DescriptionTextStyle}"/>
                                </StackPanel>
                                <Button x:Name="RunPwsh" Grid.Column="2" Content="Open" MinWidth="96" VerticalAlignment="Center" AutomationProperties.Name="Open PowerShell 7"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="LogoImage" Grid.Column="0" Height="40" Margin="0,0,12,0" Stretch="Uniform" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Recast Software"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="SummaryText" Style="{StaticResource StatusTextStyle}" FontSize="12" Foreground="#F5F5F5"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource StatusTextStyle}" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" AutomationProperties.Name="Cancel"/>
                    <Button x:Name="StartButton" Style="{StaticResource RunButtonStyle}" IsEnabled="False"
                            AutomationProperties.Name="Start deployment" ToolTip="Start the OSDCloud deployment with the selected settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF5B0;" Style="{StaticResource ButtonIconStyle}" Margin="0,0,8,0"/>
                            <TextBlock Text="Start" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
